#include <Arduino.h>
#include <lvgl.h>
#include "lv_conf.h"

// Touch driver (FT3168)
// #include "FT3168.h"    // Touch_Init()
static const uint32_t screenWidth = 466;
static const uint32_t screenHeight = 466;

// Allocate raw buffer memory (e.g., RGB565 format = 42bytes per pixel)
static uint8_t buf[screenWidth * screenHeight * 2];

static lv_disp_draw_buf_t draw_buf;
static lv_color_t buf[LCD_WIDTH * LCD_HEIGHT / 10];


void setup()
{
    Serial.begin(115200);
    delay(50);

    lv_init();

    /** ### Key Parameters
     * **`draw_buf`**: Pointer to the `lv_draw_buf_t` variable to initialize.
     * **`w` & `h`**: Width and height in pixels.
     * **`cf`**: Color format (e.g., `LV_COLOR_FORMAT_RGB565` or `LV_COLOR_FORMAT_XRGB8888`).
     * **`stride`**: Row stride in bytes (pass `0` for automatic calculation).
     * **`data`**: Pointer to the actual raw byte array.
     * **`data_size`**: Total size of the byte array in bytes.
     */
    lv_draw_buf_init(&draw_buf, screenWidth, screenHeight, LV_COLOR_FORMAT_RGB565_SWAPPED, 0, buf, sizeof(buf));

    /*Initialize the display*/
    static lv_fs_drv_t disp_drv;
    lv_fs_drv_init(&disp_drv);
    /*Change the following line to your display resolution*/
    disp_drv.hor_res = screenWidth;
    disp_drv.ver_res = screenHeight;
    disp_drv.flush_cb = my_disp_flush;
    disp_drv.draw_buf = &draw_buf;
    lv_fs_drv_register(&disp_drv);

    /* Create simple label */
    lv_obj_t *label = lv_label_create(lv_scr_act());
    lv_label_set_text(label, "Hello ESP32Cube!");
    lv_obj_align(label, LV_ALIGN_CENTER, 0, 0);
}

void loop()
{
    static long last_time = millis();

    if (millis() - last_time > 5) {
        last_time = millis();
        lv_timer_handler(); // Call lvgl's timer handler
        lv_tick_inc(5);     // Update lvgl's tick
    }
}